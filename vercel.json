{
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [{ "source": "/(dashboard|laporan|transaksi|simpan-pinjam|unit-air|gaji|buku-besar|neraca-saldo|master|data|setelan)(/.*)?", "destination": "/index.html" }],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/manifest.json", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] },
    { "source": "/(.*)\\.(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
